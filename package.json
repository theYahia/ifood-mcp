{
  "name": "@theyahia/ifood-mcp",
  "version": "1.1.0",
  "description": "MCP server for iFood Partner / Merchant API (Brazil) — 9 tools for orders, merchants, catalog, webhooks. OAuth 2.0 Client Credentials.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ifood-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.theYahia/ifood-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai",
    "ifood",
    "brazil-api",
    "food-delivery",
    "restaurants",
    "orders",
    "typescript",
    "api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/theYahia/ifood-mcp.git"
  },
  "homepage": "https://github.com/theYahia/ifood-mcp#readme",
  "author": "theYahia (https://github.com/theYahia)"
}
